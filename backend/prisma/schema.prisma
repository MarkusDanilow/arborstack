// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USER — The core entity representing an employee
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  userSkills     UserSkill[]
  projectMembers ProjectMember[]

  @@map("users")
}

// ─────────────────────────────────────────────
// SKILL — A node in the skill tree (hierarchical via parentId)
// ─────────────────────────────────────────────
model Skill {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  iconUrl     String? @map("icon_url")

  // Self-relation: skill tree hierarchy (e.g. Web Dev → JavaScript → React)
  parentId String? @map("parent_id") @db.Uuid
  parent   Skill?  @relation("SkillTree", fields: [parentId], references: [id])
  children Skill[] @relation("SkillTree")

  // Relations
  userSkills    UserSkill[]
  projectSkills ProjectSkill[]

  @@index([parentId])
  @@map("skills")
}

// ─────────────────────────────────────────────
// USER_SKILL — Junction: which skills a user has + their XP/level
// ─────────────────────────────────────────────
model UserSkill {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid

  xp    Int @default(0)
  level Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillEvents SkillEvent[]

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

// ─────────────────────────────────────────────
// SKILL_EVENT — Audit log: every XP gain with its source
// ─────────────────────────────────────────────
model SkillEvent {
  id          String          @id @default(uuid()) @db.Uuid
  userSkillId String          @map("user_skill_id") @db.Uuid
  xpAwarded   Int             @map("xp_awarded")
  source      SkillEventSource
  description String?
  occurredAt  DateTime        @default(now()) @map("occurred_at")

  // Relations
  userSkill UserSkill @relation(fields: [userSkillId], references: [id], onDelete: Cascade)

  @@index([userSkillId])
  @@index([occurredAt])
  @@map("skill_events")
}

enum SkillEventSource {
  PDF_IMPORT
  GITHUB_PR
  GITHUB_COMMIT
  PROJECT_MILESTONE
  MANUAL

  @@map("skill_event_source")
}

// ─────────────────────────────────────────────
// PROJECT — A company project with its own tech stack
// ─────────────────────────────────────────────
model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  members       ProjectMember[]
  projectSkills ProjectSkill[]

  @@map("projects")
}

// ─────────────────────────────────────────────
// PROJECT_MEMBER — Junction: user ↔ project with a specific role
// e.g. User A is "Backend Dev" in Project X, "Scrum Master" in Project Y
// ─────────────────────────────────────────────
model ProjectMember {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // The role this member holds WITHIN this specific project
  projectRole String   @map("project_role")
  joinedAt    DateTime @default(now()) @map("joined_at")
  leftAt      DateTime? @map("left_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// PROJECT_SKILL — Junction: skill ↔ project (the project's tech stack)
// XP milestone awards flow through here to all ProjectMembers
// ─────────────────────────────────────────────
model ProjectSkill {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  // XP reward distributed to all members when a milestone is reached
  milestoneXp Int @default(0) @map("milestone_xp")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
  @@map("project_skills")
}
