flowchart TB
 subgraph Frontend["Frontend Layer - Next.js & React Flow"]
        UI_Dash["Dashboard view"]
        UI_Tree["My Skill Tree view"]
        UI_Proj["Projects & Roles view"]
        UI_Team["Team Directory view"]
        UI_Set["Settings & Integrations"]
  end
 subgraph Backend["Backend Layer - Node.js & Fastify"]
        API_Gate["Fastify API Gateway"]
        Auth["Auth & Integrations Logic"]
        XP_Calc["XP Engine & Event Manager"]
        Parser_Ctrl["PDF AI Parser Controller"]
  end
 subgraph AI_Layer["Local AI Layer - Docker"]
        Ollama["Ollama Inference Server"]
        LLM["Llama 3 / Mistral Model"]
  end
 subgraph Database["Persistence Layer - PostgreSQL"]
        DB[("Relational DB + Prisma ORM")]
  end
    UI_Dash --> API_Gate
    UI_Tree --> API_Gate
    UI_Proj --> API_Gate
    UI_Team --> API_Gate
    UI_Set --> API_Gate
    API_Gate --> Auth & XP_Calc & Parser_Ctrl
    Parser_Ctrl -- "1. Sends Raw Text" --> Ollama
    Ollama -- "2. Prompting" --> LLM
    LLM -- "3. Structured JSON" --> Ollama
    Ollama -- "4. Returns Parsed Skills" --> Parser_Ctrl
    Auth --> DB
    XP_Calc --> DB
    Parser_Ctrl --> DB

